{
  "name": "ml-course-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "content": "node ../scripts/build-content.js",
    "predev": "node ../scripts/build-content.js --if-missing",
    "dev": "vite",
    "build": "node ../scripts/build-content.js && vite build",
    "preview": "vite preview",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "cd android && gradlew.bat assembleDebug",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.5.2",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@fontsource/onest": "^5.3.1",
    "firebase": "^12.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^2.0.0"
  }
}
