{
  "firestore": { "rules": "firestore.rules" },
  "hosting": {
    "public": "app/dist",
    "ignore": ["firebase.json", "**/.*"],
    "headers": [
      { "source": "static/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
      { "source": "**/*.@(html|json)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  }
}
